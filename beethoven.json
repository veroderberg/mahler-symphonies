    "total_duration_min": 44.0,
    "notes": "Five movements; Beethoven's only programmatic symphony. Premiered on the same concert as the Fifth. Piccolo and two trombones enter in the storm (mvt 4).",
    "movements": [
      {
        "number": 1,
        "label": "Awakening of cheerful feelings",
        "tempo_marking": "Allegro ma non troppo",
        "duration_min": 12.0,
        "voices": null,
        "notes": "Beethoven: 'More the expression of feeling than painting'."
      },
      {
        "number": 2,
        "label": "Scene by the brook",
        "tempo_marking": "Andante molto mosso",
        "duration_min": 13.0,
        "voices": null,
        "notes": "Flute = nightingale, oboe = quail, clarinets = cuckoo; birdsong cadenza at close."
      },
      {
        "number": 3,
        "label": "Merry gathering of country folk",
        "tempo_marking": "Allegro",
        "duration_min": 5.0,
        "voices": null,
        "notes": "Interrupted by the thunderstorm; attacca into mvt 4."
